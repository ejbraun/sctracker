<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="004-create-machine-keys" author="uwtracker">
        <createTable tableName="machine_keys">
            <column name="id" type="BIGINT UNSIGNED" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="person_id" type="BIGINT UNSIGNED">
                <constraints nullable="false"/>
            </column>
            <column name="key_hash" type="CHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_machine_keys_hash"/>
            </column>
            <column name="label" type="VARCHAR(64)"/>
            <column name="created_at" type="DATETIME(6)" defaultValueComputed="CURRENT_TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
            <column name="revoked_at" type="DATETIME(6)"/>
        </createTable>
        <createIndex indexName="idx_machine_keys_person" tableName="machine_keys">
            <column name="person_id"/>
        </createIndex>
        <addForeignKeyConstraint baseTableName="machine_keys" baseColumnNames="person_id"
                                  constraintName="fk_machine_keys_person"
                                  referencedTableName="people" referencedColumnNames="id"
                                  onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
