<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- 013-seed-underworld-role-objectives.xml incorrectly credited T2 on Chamber - T2 does not
         take part in the Chamber trial. -->
    <changeSet id="018-remove-t2-chamber-role-objective" author="uwtracker">
        <delete tableName="role_objectives">
            <where>map_id = 72 AND objective_name = 'Chamber' AND role = 'T2'</where>
        </delete>
    </changeSet>

</databaseChangeLog>
