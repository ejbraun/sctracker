<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- "deaths" per party member — a newly-observed field on the upload payload, not in the
         original spec draft (same situation as is_player/is_hero/is_henchman in 008). Defaults to
         0 for a payload that omits it (older plugin version). -->
    <changeSet id="014-add-run-participants-deaths" author="uwtracker">
        <addColumn tableName="run_participants">
            <column name="deaths" type="SMALLINT UNSIGNED" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
