<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Admin-minted, single-use, expiring link that lets one specific user set a new password
         (POST /api/admin/users/{id}/password-reset -> POST /api/password-reset). Redemption is an
         atomic "used_at = now WHERE used_at IS NULL AND expires_at > now". Only SHA-256(token) hex
         is stored, so a DB dump can't reconstruct a usable link. -->
    <changeSet id="056-create-password-reset-tokens" author="uwtracker">
        <createTable tableName="password_reset_tokens">
            <column name="id" type="BIGINT UNSIGNED" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="person_id" type="BIGINT UNSIGNED">
                <constraints nullable="false"/>
            </column>
            <column name="token_hash" type="CHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_password_reset_tokens_token_hash"/>
            </column>
            <column name="expires_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="used_at" type="DATETIME(6)"/>
            <column name="created_by_person_id" type="BIGINT UNSIGNED"/>
            <column name="created_at" type="DATETIME(6)" defaultValueComputed="CURRENT_TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="password_reset_tokens" baseColumnNames="person_id"
                                  constraintName="fk_password_reset_tokens_person"
                                  referencedTableName="people" referencedColumnNames="id"
                                  onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="password_reset_tokens" baseColumnNames="created_by_person_id"
                                  constraintName="fk_password_reset_tokens_created_by"
                                  referencedTableName="people" referencedColumnNames="id"
                                  onDelete="SET NULL"/>
    </changeSet>

    <!-- Sessions that logged in before this instant are rejected by SessionAuthInterceptor. Set on
         a password reset so the old password's sessions die with it. -->
    <changeSet id="056-add-people-sessions-valid-after" author="uwtracker">
        <addColumn tableName="people">
            <column name="sessions_valid_after" type="DATETIME(6)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
