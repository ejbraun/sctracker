    <!-- Which roles' section times count toward that objective's personal best (specs/backend/05 —
         "role-gated"), for The Fissure of Woe (map 34), 2-person duo. A duo is present for the whole
         run, so both roles are "involved" in every objective — every FoW objective x {Ranger, Derv}.
         Objective names exactly as they arrive from the plugin (GWToolboxdll's FoW ObjectiveSet).
         Same shape as 013-seed-underworld-role-objectives.xml. -->
    <changeSet id="039-seed-fow-duo-role-objectives" author="uwtracker">
        <insert tableName="role_objectives"><column name="map_id" valueNumeric="34"/><column name="objective_name" value="ToC"/><column name="role" value="Ranger"/></insert>
