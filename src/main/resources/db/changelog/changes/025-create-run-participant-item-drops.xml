<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- One row per (participant, tracked item) that dropped for them during the run — measures loot
         *reservation* (GAME_SMSG_ITEM_UPDATE_OWNER), not confirmed pickup, per the plugin's payload
         summary. "count" is a reserved word in MySQL (aggregate function name), hence "drop_count". -->
    <changeSet id="025-create-run-participant-item-drops" author="uwtracker">
        <createTable tableName="run_participant_item_drops">
            <column name="run_participant_id" type="BIGINT UNSIGNED">
                <constraints nullable="false"/>
            </column>
            <column name="item_id" type="INT UNSIGNED">
                <constraints nullable="false"/>
            </column>
            <column name="drop_count" type="SMALLINT UNSIGNED">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="run_participant_item_drops" columnNames="run_participant_id, item_id"
                        constraintName="pk_run_participant_item_drops"/>
        <addForeignKeyConstraint baseTableName="run_participant_item_drops" baseColumnNames="run_participant_id"
                                  constraintName="fk_run_participant_item_drops_participant"
                                  referencedTableName="run_participants" referencedColumnNames="id"
                                  onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="run_participant_item_drops" baseColumnNames="item_id"
                                  constraintName="fk_run_participant_item_drops_item"
                                  referencedTableName="tracked_items" referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
